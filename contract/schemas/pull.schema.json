{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contexo.live/schemas/ctx/v1/pull.schema.json",
  "title": "ctx pull --json (PullDoc, ctx.pull.v1)",
  "description": "Contract v1 (contract/ctx-json-v1.md). Hand-maintained; $defs with the same name are identical in every contract/schemas file. Unknown properties are allowed (forward compatible).",
  "type": "object",
  "required": [
    "schema",
    "server_url",
    "repo_id",
    "written",
    "adopted",
    "skipped",
    "reindexed",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "ctx.pull.v1"
    },
    "server_url": {
      "type": "string"
    },
    "repo_id": {
      "type": "string"
    },
    "head": {
      "$ref": "#/$defs/sha"
    },
    "written": {
      "type": "array",
      "description": "Working file and base written; kind is always set.",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/pulledPage"
          }
        ],
        "required": [
          "kind"
        ]
      }
    },
    "adopted": {
      "type": "array",
      "description": "Content already identical: base fast-forwarded, file untouched.",
      "items": {
        "$ref": "#/$defs/pulledPage"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skippedPage"
      }
    },
    "reindexed": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "description": "Open code set (error, warning and note codes, skip reasons): unknown values are allowed.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pageState": {
      "type": "string",
      "description": "CLOSED v1 enum: a new value is contract 2.",
      "enum": [
        "unchanged",
        "modified",
        "new",
        "incoming",
        "incoming_new",
        "conflict",
        "deleted_local",
        "invalid",
        "unverified"
      ]
    },
    "pulledPage": {
      "type": "object",
      "required": [
        "path",
        "sha"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "sha": {
          "$ref": "#/$defs/sha"
        },
        "kind": {
          "$ref": "#/$defs/writeKind"
        }
      }
    },
    "relPath": {
      "type": "string",
      "description": "'/'-separated path relative to <root>/.contexo/.",
      "pattern": "^[^/\\\\]"
    },
    "sha": {
      "type": "string",
      "description": "Full 40-hex commit sha.",
      "pattern": "^[0-9a-f]{40}$"
    },
    "skippedPage": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "state": {
          "$ref": "#/$defs/pageState"
        },
        "reason": {
          "$ref": "#/$defs/code"
        },
        "server_sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message",
        "paths"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "message": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relPath"
          }
        }
      }
    },
    "writeKind": {
      "type": "string",
      "enum": [
        "create",
        "update"
      ]
    }
  }
}
