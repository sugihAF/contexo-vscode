{
  "rules": [
    {"match":["status","--json"],"unless":["--offline"],"stdoutFile":"../e7-resolve/status.json"},
    {"match":["status","--offline"],"stdoutFile":"../e7-resolve/status-offline.json"},
    {"match":["resolve","wiki/concepts/rate-limits.md"],"exit":6,"stderrFile":"stale.stderr"},
    {"match":["resolve","wiki/concepts/retry-policy.md","--theirs"],"stdoutFile":"../e7-resolve/resolve.retry-policy.theirs.json"},
    {"match":["resolve","wiki/concepts/retry-policy.md","--ours"],"stdoutFile":"../e7-resolve/resolve.retry-policy.ours.json"}
  ]
}
